# ---- Required for any LLM stage ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Required for metadata (free account) ----
# https://www.themoviedb.org/settings/api  -> use the v4 "API Read Access Token"
TMDB_READ_TOKEN=
# or the older v3 key, if that is what you have:
TMDB_API_KEY=

# ---- Optional: subtitles ----
# https://www.opensubtitles.com/en/consumers  (free tier: ~5 downloads/day,
# 100+/day on a VIP account). Search works with the key alone; DOWNLOADING
# also needs your site login below.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Escape hatch: a folder of .srt files named <film_id>.srt (e.g. tmdb-8587.srt).
# Anything found here is used in preference to the API, so you can hand-supply
# tracks for the 40 phase-0 films without touching OpenSubtitles at all.
SUBTITLES_DIR=

# ---- Model settings ----
ATLAS_MODEL=claude-opus-5
ATLAS_EFFORT=high
ATLAS_CONCURRENCY=6
