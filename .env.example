# ---- Required for any LLM stage ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Required for metadata (free account) ----
# https://www.themoviedb.org/settings/api  -> use the v4 "API Read Access Token"
TMDB_READ_TOKEN=
# or the older v3 key, if that is what you have:
TMDB_API_KEY=

# ---- Subtitles ----
# You very likely need NOTHING here. The default source is the OPUS research
# archive, which needs no account and has no daily limit:
#
#     atlas opus-index --version v2024
#
# That covers 444,595 titles through ~2024. Only films newer than the archive
# release need one of the options below.

# Fallback for very recent films. Limits are low: 5 downloads/day anonymous,
# 20/day with a free account, ~1000/day on a paid VIP subscription.
# https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Highest-priority source, always preferred when present: a folder of .srt
# files named <film_id>.srt (e.g. the-lion-king-1994.srt). This is the only
# route that can carry SDH speaker labels, which OPUS strips.
SUBTITLES_DIR=

# ---- Alternative scorers, for the bias audit ----
# Every score in the atlas came from one model, so an equally good explanation
# of the corpus is that we measured one model's moral opinions forty times.
# `atlas model-scan` re-scores the same films with other models to tell those
# explanations apart. All three are optional; a missing key means that scorer
# sits the comparison out. See `atlas models`.

# Grok. xAI trains explicitly against moralising, which makes it the sharpest
# contrast with a safety-trained scorer. https://console.x.ai/
XAI_API_KEY=

# DeepSeek. Guardrails in different places rather than absent — trained under a
# different regulatory regime. Also by far the cheapest of the three.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter. One key reaches the open-weight models no first-party API hosts,
# which is the only practical route to a scorer with no refusal training:
#   hermes      neutrally aligned, minimal refusal training  <- recommended
#   dolphin     alignment data stripped from the fine-tune
#   llama-base  no instruction tuning at all — the purest control
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Model settings ----
# Sonnet 5 is the default: it supports adaptive thinking and effort like Opus,
# and at $3/$15 per Mtok (intro $2/$10 until 2026-08-31) it is ~2.5x cheaper.
# claude-opus-5   $5/$25   best judgement; use for a final scoring run
# claude-sonnet-5 $3/$15   the default
# claude-haiku-4-5 $1/$5   cheapest, 200K context. NOTE: no adaptive thinking
#                          and no effort setting — the client detects this and
#                          drops both, but judgement quality drops with it.
ATLAS_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max. Thinking tokens are billed as output and
# come out of the same max_tokens pool, so effort is the single biggest lever on
# cost after the model itself. `medium` is a reasonable default for extraction;
# raise to `high` for the scoring run that actually produces your numbers.
ATLAS_EFFORT=medium
ATLAS_CONCURRENCY=6
