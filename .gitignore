.venv/
__pycache__/
*.pyc
.env
# Fetched corpora and indexes: hundreds of MB, and reproducible from the
# public sources on demand, so there is nothing to gain by carrying them.
data/cache/
# The store is a large binary that changes wholesale on every write, which is
# not a thing to keep in git. It also holds user records — users, sessions and
# test results — which is the reason that outlives the size one.
data/*.duckdb
data/*.duckdb.wal
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
*.egg-info/
build/
dist/
.pytest_cache/
.DS_Store

# Claude Code local worktrees and session scratch
.claude/
.pytest_cache/
